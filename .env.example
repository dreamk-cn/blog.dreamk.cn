# Core (required)
DATABASE_URL=postgresql://blog:blog_password@127.0.0.1:5432/blog?schema=public
NEXT_PUBLIC_BASE_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-random-secret
# NextAuth v5 OAuth callback base; recommended in production
AUTH_URL=http://localhost:3000
ADMIN_EMAIL=your-admin@example.com

# OAuth (optional, must be set in pairs)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email SMTP (optional; comment notifications skip when unset)
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# DeepSeek AI (optional; admin AI features disabled when unset)
DEEPSEEK_API_KEY=
DEEPSEEK_EXCERPT_MODEL=
DEEPSEEK_SLUG_MODEL=

# Aliyun OSS (optional; media upload requires full OSS config)
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=
OSS_REGION=cn-hangzhou
OSS_URL=
OSS_PREFIX=blog
OSS_MAX_FILE_SIZE_MB=5

# Cache
CACHE_DRIVER=postgres

# Rate limits (optional; defaults match README)
AUTH_REGISTER_RATE_MAX=5
AUTH_REGISTER_RATE_WINDOW_SEC=3600
AUTH_LOGIN_RATE_MAX=10
AUTH_LOGIN_RATE_WINDOW_SEC=300
AUTH_REGISTER_CODE_TTL_SEC=600
AUTH_REGISTER_SEND_CODE_IP_MAX=5
AUTH_REGISTER_SEND_CODE_IP_WINDOW_SEC=3600
AUTH_REGISTER_SEND_CODE_EMAIL_MAX=3
AUTH_REGISTER_SEND_CODE_EMAIL_WINDOW_SEC=3600
AUTH_REGISTER_SEND_CODE_COOLDOWN_SEC=60
ANONYMOUS_COMMENT_RATE_MAX=5
ANONYMOUS_COMMENT_RATE_WINDOW_SEC=60

# Post view count: same IP + slug within window; POST_VIEW_RATE_MAX=0 disables
POST_VIEW_RATE_MAX=1
POST_VIEW_RATE_WINDOW_SEC=86400

# Admin comment email dedup per post; COMMENT_NOTIFY_ADMIN_COOLDOWN_SEC=0 disables
COMMENT_NOTIFY_ADMIN_COOLDOWN_SEC=300

# Reverse proxy (set TRUST_PROXY=true behind Nginx/Cloudflare for accurate client IP)
TRUST_PROXY=false

# Access log retention in days (optional purge via access-log-service)
ACCESS_LOG_RETENTION_DAYS=90

# CI / special builds only
# SKIP_ENV_VALIDATION=1
